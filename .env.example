# Backplane configuration.
#
# Every key here maps to a field on `Settings` in backend/app/config.py.
# A drift test (backend/tests/test_env_example_drift.py) fails if this file
# names a backend key that does not exist there — keep them in sync.
#
# Copy to `.env`. The defaults below work for local development as-is.
#
# This root file is what docker compose reads. The backend process itself
# reads `.env` relative to its own working directory, which for native
# (non-Docker) runs is `backend/` — so for native-only overrides, copy this
# to `backend/.env` instead. Compose-only keys are harmless there
# (Settings.model_config sets extra="ignore").

# ─── Self-hosting (docker-compose.prod.yml only) ─────────────────────────────
# These keys are consumed by the prod compose file, not the backend. Local dev
# (`make dev`) ignores them.
#
# Password for the bundled Postgres service. REQUIRED — the prod compose
# refuses to start without it. Keep the literal password; do not URL-encode it.
# Single-quote values containing $ or # so Compose preserves them literally:
# POSTGRES_PASSWORD='replace-with-a-strong-generated-password'
POSTGRES_PASSWORD=

# The URL you open Backplane at, as the browser sees it. Leave empty when
# browsing from the docker host itself (defaults to http://localhost:8080).
# Set it when accessing from another machine (http://192.168.1.50:8080) or
# behind TLS (https://backplane.example). It drives CORS, OAuth/OIDC callback
# URLs, the API URL baked into exported runner bundles, and whether session
# cookies are marked Secure (https origins only).
BACKPLANE_URL=

# Host port the web UI is published on.
BACKPLANE_HTTP_PORT=8080

# Postgres init args — only take effect on that volume's first startup.
# Changing them later does NOT rename/recreate the already-initialized
# database; you'd need to touch the postgres-data volume yourself.
# POSTGRES_USER=backplane
# POSTGRES_DB=backplane

# Reserved image names for custom Compose overrides. These values
# do not select artifacts in docker-compose.prod.yml: that stack uses
# build: plus pull_policy: build and therefore rebuilds from the
# checked-out source. To run published images, supply a separate
# Compose override that removes build:.
# BACKPLANE_BACKEND_IMAGE=ghcr.io/valaris-studio/backplane-backend:latest
# BACKPLANE_FRONTEND_IMAGE=ghcr.io/valaris-studio/backplane-frontend:latest
# BACKPLANE_RUNNER_IMAGE=ghcr.io/valaris-studio/backplane-runner:latest

# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://valaris:valaris@localhost:5433/valaris
# Optional literal password override for native runs; URL encoding is automatic.
# Production Compose supplies this from POSTGRES_PASSWORD.
# DATABASE_PASSWORD=
ENV=development
PORT=8000

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Operator-facing backend URL baked into exported runner bundles (the runner's
# `valaris.api_url` and the MCP config's VALARIS_API_URL). Set this to your
# public backend URL in production so exported configs are launch-ready.
API_URL=http://localhost:8000

# Origin the OAuth callback returns to once a git connection is persisted.
FRONTEND_URL=http://localhost:5173

# ─── Authentication ──────────────────────────────────────────────────────────
# Production refuses to start unless at least one verifier is available: local
# password login (on by default), OIDC (section below), IAP, or a trusted
# proxy. Development trusts X-User-Email and ignores all of them. SECURITY.md.
#
# Built-in email + password login, credentials stored in Backplane's own
# database (argon2id). The zero-dependency option: a fresh instance shows a
# first-run screen to create the admin account. Disable only when another
# verifier handles all sign-ins.
LOCAL_AUTH_ENABLED=true

# HMAC key that signs login session cookies (local auth + OIDC) and the OAuth
# state cookie. REQUIRED for any login flow — without it the first-run admin
# setup fails with "Session signing key is not configured".
# Generate with: openssl rand -hex 32
OAUTH_STATE_SIGNING_KEY=

# Google Cloud IAP audience. When set, the backend verifies IAP's signed JWT.
IAP_AUDIENCE=

# Trust an identity header set by an authenticating proxy in front of the
# backend (oauth2-proxy, Authelia, ...). There is no signature to check, so this
# is only safe when the backend is unreachable except through that proxy AND the
# proxy strips client-supplied copies of the header.
# oauth2-proxy users: TRUSTED_PROXY_AUTH_HEADER=X-Forwarded-Email
TRUSTED_PROXY_AUTH=false
TRUSTED_PROXY_AUTH_HEADER=X-Goog-Authenticated-User-Email

# Optional handshake for trusted-proxy mode: when set, requests must also carry
# X-Backplane-Proxy-Secret with this exact value (configure your proxy to
# inject it). Defense in depth if the backend port is ever reachable directly.
TRUSTED_PROXY_SECRET=

# Comma-separated email domains allowed to sign in via IAP / trusted-proxy
# (API keys and dev mode are exempt). Empty allows any verified email.
AUTH_ALLOWED_EMAIL_DOMAINS=

# Create user accounts on first sign-in. Set to false for invite-only
# deployments: unknown emails get 403 until an account is created for them.
AUTH_AUTO_PROVISION=true

# ─── OIDC login (optional) ───────────────────────────────────────────────────
# Point Backplane at any OpenID Connect provider (Keycloak, Authentik, Google,
# Entra, Okta) for first-class login without a fronting proxy. Everything is
# derived from the issuer's discovery document. Empty OIDC_ISSUER = disabled.
# The redirect URI to register with your IdP is:
#   {API_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Lifetime of the signed session cookie for ANY login — local password auth
# and first-run admin setup included, not just OIDC (seconds).
OIDC_SESSION_TTL_SECONDS=43200

# ─── Telemetry (off, and currently going nowhere) ────────────────────────────
# Backplane sends NOTHING by default. Setting this to true opts into an
# anonymous ping: a hashed instance id (derived one-way from DATABASE_URL, so
# it never reveals your credentials or hostname), the version, the Python
# version, and how many users/workspaces exist — no names, emails, slugs, or
# any card content.
#
# There is deliberately no default endpoint: no receiving service exists yet,
# so enabling the flag alone does nothing. Point ENDPOINT at your own collector
# if you want the data locally.
BACKPLANE_TELEMETRY_ENABLED=false
BACKPLANE_TELEMETRY_ENDPOINT=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Leave GCS_BUCKET empty to use local disk (LOCAL_STORAGE_DIR). Set it to a
# bucket name to store uploads in Google Cloud Storage instead.
GCS_BUCKET=
GCS_SA_EMAIL=
LOCAL_STORAGE_DIR=data/resources

# ─── Event bus ───────────────────────────────────────────────────────────────
# memory   = single instance, zero dependencies (default)
# postgres = cross-instance fan-out via LISTEN/NOTIFY, required to scale
#            WebSockets across more than one backend instance
# See docs/events.md.
EVENT_BUS_BACKEND=memory

# ─── Caching ─────────────────────────────────────────────────────────────────
# Tier-1 in-process caches (slug→workspace resolution) are cross-instance-correct
# only under EVENT_BUS_BACKEND=postgres, where eviction events reach every
# instance. Set this to true ONLY for a genuinely single-instance deployment;
# otherwise leave it false and the caches stay pass-through.
# See docs/caching-policy.md.
CACHE_SINGLE_INSTANCE=false

# ─── WebSockets ──────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_PONG_TIMEOUT=10

# ─── Git forge access ────────────────────────────────────────────────────────
# Platform-wide fallback tokens for the backend merge queue, done-merge gate,
# reconciler and scheduler. These are the LAST step of credential resolution: a
# workspace's own Git Connection (Workspace Settings → Git Connections) wins
# first. See docs/git-credentials.md.
#
# Each token is host-checked before use: GITHUB_TOKEN serves github.com only
# (or GITHUB_API_URL's host), GITLAB_TOKEN serves gitlab.com only, and there is
# no cross-provider borrowing — a gitlab repo never receives GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITLAB_TOKEN=
# Set but inert: gitea has no canonical host, so this token can never be
# host-matched to a repo. Self-hosted gitea needs a workspace Git Connection
# with a base_url instead.
GITEA_TOKEN=

# Whether a repo with no matching workspace git-connection may fall back to the
# platform tokens above. Set false on multi-tenant deployments so each
# workspace must bring its own credential and the platform's token is never
# embedded into a tenant's clone URL. Host matching is enforced either way.
ALLOW_GLOBAL_TOKEN_FALLBACK=true

# Identity the merge worker authors rebase/squash commits as.
GIT_USER_NAME=Backplane Merge Bot
GIT_USER_EMAIL=merge-bot@valaris.studio

# How long a merge-queue entry may sit queued/merging before board health
# reports it as stuck. Raise it if your merges legitimately run long.
MERGE_QUEUE_STALE_THRESHOLD_SECONDS=300

# ─── Git connections (workspace-owned forge credentials) ─────────────────────
# Base64-encoded 32-byte Fernet key encrypting stored forge tokens at rest —
# both OAuth tokens and pasted access tokens (PATs). Empty means the vault
# refuses to encrypt or decrypt, so tokens are never stored in plaintext and
# BOTH connection paths fail: required to use Git Connections at all.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Treat it like a database credential: losing it makes every stored token
# unrecoverable (re-paste them). Rotating means decrypt-with-old then
# re-encrypt-with-new — swapping the key alone orphans what is already stored.
INTEGRATIONS_TOKEN_KEY=

# ─── Git OAuth integrations (optional) ───────────────────────────────────────
# Only for the "Connect GitHub" OAuth path — the pasted-token path needs
# nothing here. Leave empty to disable OAuth; the start endpoint 503s rather
# than redirecting nowhere.

# GitHub OAuth App with callback {API_URL}/api/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# The OAuth state cookie is signed with OAUTH_STATE_SIGNING_KEY — declared in
# the Authentication section above (it also signs login sessions). Distinct
# from INTEGRATIONS_TOKEN_KEY: different threat model, different rotation
# cadence.

# ─── Runner (docker compose `runner` profile only) ───────────────────────────
# Not backend settings — consumed by the runner container in docker-compose.
# VALARIS_API_KEY=vlr_...                   # Agent key (POST /api/me/api-keys)
# VALARIS_WORKSPACE=my-workspace            # Workspace slug the runner works in
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...  # `claude setup-token`
# GH_TOKEN=gho_...                          # `gh auth token`, for push + PRs
# Host path to a runner.yaml mounted into the container (default ships a
# ready-to-edit example).
# BACKPLANE_RUNNER_CONFIG=./runner/configs/runner.example.yaml
