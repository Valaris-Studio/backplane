FROM node:22-alpine
WORKDIR /app
ENV CI=true
# Pinned to the same pnpm as the prod builder (frontend/Dockerfile) --
# drift-tested by backend/tests/test_pnpm_config_drift.py so dev and prod
# always resolve dependencies with the same pnpm major version.
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate

# Build installs from the committed standalone lockfile (frozen) so the image
# resolves identically to prod, not whatever `pnpm install` would pick fresh.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
# compose bind-mounts frontend/ over /app at runtime, so this is really a
# volume warm-up / reconcile pass against whatever the host has on disk --
# still --frozen-lockfile so a lockfile that's drifted from package.json
# fails loudly here instead of silently re-resolving a different tree.
CMD ["sh", "-c", "pnpm install --frozen-lockfile --prefer-offline && exec pnpm dev --host"]
