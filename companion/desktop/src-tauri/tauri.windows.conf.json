{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "Backplane Companion",
        "url": "index.html",
        "width": 360,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
