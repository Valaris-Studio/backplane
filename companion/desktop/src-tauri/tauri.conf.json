{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backplane Companion",
  "version": "0.1.0",
  "identifier": "dev.backplane.companion.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "title": "Backplane Companion",
        "url": "index.html",
        "width": 360,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "popover",
            "hudWindow"
          ],
          "state": "followsWindowActiveState",
          "radius": 12
        },
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'",
      "capabilities": [
        "popover"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
