{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "Backplane Companion",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "visible": false,
        "focus": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "shadow": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "Backplane Companion desktop app",
    "linux": {
      "deb": {
        "depends": [
          "xdg-utils"
        ],
        "section": "devel"
      },
      "rpm": {
        "depends": [
          "xdg-utils"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
