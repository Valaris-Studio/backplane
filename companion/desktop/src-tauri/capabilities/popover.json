{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "The tray popover: core defaults, dragging the window by its header, plus exactly the app commands it calls. No shell, fs, opener, dialog, autostart or notification permissions reach JS; those plugins are used from Rust commands only.",
  "windows": [
    "popover"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-status",
    "allow-pause",
    "allow-resume",
    "allow-projects",
    "allow-agents",
    "allow-boards",
    "allow-sessions",
    "allow-pair-start",
    "allow-pair-poll",
    "allow-pair-cancel",
    "allow-rename",
    "allow-disconnect",
    "allow-version",
    "allow-subscribe-events",
    "allow-open-backplane-url",
    "allow-app-location",
    "allow-enable-capture",
    "allow-capture-repair",
    "allow-pick-project-folder",
    "allow-reveal-agent-config",
    "allow-save-diagnostics",
    "allow-launch-at-login-get",
    "allow-launch-at-login-set",
    "allow-notifications-get",
    "allow-notifications-set",
    "allow-hide-popover",
    "allow-check-for-update",
    "allow-install-update",
    "allow-last-update-result",
    "allow-update-channel-get",
    "allow-update-channel-set",
    "allow-queue-flush",
    "allow-agent-install",
    "allow-agent-uninstall",
    "allow-update-settings",
    "allow-mapping-create",
    "allow-mapping-update",
    "allow-mapping-delete",
    "allow-project-ignore",
    "allow-project-unignore",
    "allow-session-get",
    "allow-session-usage",
    "allow-display-path",
    "allow-companion-uninstall",
    "allow-start-companion-service",
    "allow-install-agent-hooks",
    "allow-pair-current",
    "allow-quit-app",
    "allow-platform-info",
    "allow-agent-access-get",
    "allow-agent-access-set",
    "allow-open-uv-install-page",
    "allow-onboarding-active-set"
  ]
}
